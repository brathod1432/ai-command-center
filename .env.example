# Helm — environment configuration example.
# Copy to .env.local for local development. NEVER commit real secrets.

# Session signing secret (use a long random value in real deployments).
SESSION_SECRET=dev-only-change-me

# Deployment / tenancy
NODE_ENV=development
DEFAULT_TENANT_ID=acme

# Feature flags
NEXT_PUBLIC_ENABLE_SHOWCASE=true

# Real integrations (unused in the reference build — mock providers are used).
# GITHUB_TOKEN=
# JIRA_BASE_URL=
# SLACK_TOKEN=
